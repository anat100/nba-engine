    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst MIN_CONF = 0.6;               // below this -> human handoff\nconst CHANNELS = ['email', 'in_app', 'human', 'none'];\nfunction finish(c, d) {\n  d.confidence = Math.max(0, Math.min(1, Number(d.confidence) || 0));\n  if (!CHANNELS.includes(d.channel)) d.channel = 'none';\n  const needsHuman = d.action === 'human_handoff' || d.channel === 'human'\n                     || d.confidence < MIN_CONF || c.is_high_value === true;\n  let routed_to = 'none';\n  if (d.action === 'no_action') routed_to = 'none';\n  else if (needsHuman) routed_to = 'human';\n  else if (d.channel === 'email' || d.channel === 'in_app') routed_to = d.channel;\n  return { json: {\n    user_id: c.user_id, email: c.email, language: c.language, company_name: c.company_name, role: c.role,\n    signal_type: c.signal_type, arm: c.arm, ab_variant: c.ab_variant, is_high_value: c.is_high_value,\n    action: d.action, channel: d.channel, timing: d.timing, message_angle: d.message_angle,\n    confidence: d.confidence, reasoning: d.reasoning, routed_to,\n    payload: { user_id: c.user_id, action: d.action, channel: d.channel, timing: d.timing,\n               message_angle: d.message_angle, variant: c.ab_variant, signal_type: c.signal_type,\n               signal_detail: c.signal_detail }\n  }};\n}\n\nconst c = $json;\nconst RULES = {\n  viewed_no_bid:    { action: 'send_tender_digest', message_angle: 'deadline_reminder',     timing: 'next_business_morning' },\n  gc_single_tender: { action: 'send_nudge',         message_angle: 'second_tender_prompt',  timing: 'in_3_days' },\n  idle_14d:         { action: 'send_tender_digest', message_angle: 'new_matching_tenders',  timing: 'next_business_morning' },\n};\nconst r = RULES[c.signal_type] || { action: 'no_action', message_angle: 'none', timing: 'now' };\nreturn finish(c, { ...r, channel: 'email', confidence: 1, reasoning: 'Static rule for signal ' + c.signal_type });\n"
      },
      "id": "0c427427-4f52-4f5c-b820-150e7184d46b",
